LULU_STORAGE_DIR=./storage
# 默认禁用；fake 仅验证流程，diffusers 才调用真实生成模型。
LULU_GENERATOR=disabled
LULU_MAX_UPLOAD_BYTES=15728640
LULU_MAX_ACTIVE_JOBS=20
LULU_JOB_TTL_HOURS=24
LULU_OUTPUT_SCALE=2
LULU_INFERENCE_SIZE=1024
LULU_INFERENCE_STEPS=30
# 真实 GPU 环境填写模型（例如 diffusers/stable-diffusion-xl-1.0-inpainting-0.1）。
LULU_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
LULU_MODEL_REVISION=main
LULU_DEVICE=cuda
# 留空使用包内 characters.json，A/B prompt、referenceImage 和 glb 可为空。
# LULU_CHARACTER_CATALOG=/absolute/path/characters.json
# 有参考图时才配置兼容当前基础模型的 IP-Adapter；令牌只放运行环境。
LULU_IP_ADAPTER_ID=h94/IP-Adapter
LULU_IP_ADAPTER_SUBFOLDER=sdxl_models
LULU_IP_ADAPTER_WEIGHT=ip-adapter_sdxl.bin

# 相对于服务进程工作目录；Docker 已设为 /assets/characters
LULU_ASSET_DIR=../assets/characters
LULU_GENERATION_TIMEOUT_SECONDS=300
